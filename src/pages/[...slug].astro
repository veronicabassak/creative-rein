---
import type { GetStaticPaths } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Sections from '@/components/Sections.astro';

/**
 * One route for every page in src/content/pages.
 * home.json becomes "/", anything else becomes "/<file-name>/".
 */
export const getStaticPaths = (async () => {
  const pages = await getCollection('pages');
  return pages.map((page) => ({
    params: { slug: page.id === 'home' ? undefined : page.id },
    props: { page },
  }));
}) satisfies GetStaticPaths;

interface Props {
  page: CollectionEntry<'pages'>;
}

const { page } = Astro.props;
---

<BaseLayout title={page.data.title} description={page.data.description} noindex={page.data.noindex}>
  <Sections sections={page.data.sections} />
</BaseLayout>
