---
import { Image } from 'astro:assets';
import type { SectionOf } from '@/content.config';
import { resolveImage, focusStyle } from '@/lib/images';

type Props = SectionOf<'list'>;

const { id, heading, intro, style, items, note, background, link } = Astro.props;
const ListTag = style === 'steps' ? 'ol' : 'ul';
---

<section id={id} class:list={['section', 'list-section', `bg-${background}`]}>
  <div class="container">
    <div class="head">
      <h2>{heading}</h2>
      {intro && <p>{intro}</p>}
    </div>

    <ListTag class:list={['items', `style-${style}`, `count-${items.length}`]}>
      {
        items.map((item) => (
          <li class="item">
            {item.image && (
              <Image
                class="item-photo"
                src={resolveImage(item.image.src)}
                alt={item.image.alt}
                style={focusStyle(item.image.focus)}
                widths={[360, 540, 720]}
                sizes="(min-width: 56rem) 24rem, 100vw"
              />
            )}
            <div class="item-body">
              {item.title && <h3>{item.title}</h3>}
              {item.text && <p>{item.text}</p>}
              {item.points.length > 0 && (
                <ul class="points">
                  {item.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ListTag>

    {
      (note || link) && (
        <div class="foot">
          {note && <p>{note}</p>}
          {link && (
            <a class="button button--quiet" href={link.href}>
              {link.label}
            </a>
          )}
        </div>
      )
    }
  </div>
</section>

<style>
  .bg-oat {
    background: var(--oat-light);
  }

  .head {
    display: grid;
    gap: 0.75rem;
    max-width: var(--measure);
    margin-bottom: 2rem;
  }

  .items {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .item-body {
    display: grid;
    gap: 0.375rem;
    align-content: start;
  }

  h3 {
    font-size: clamp(1.1875rem, 1.1rem + 0.4vw, 1.375rem);
  }

  .points {
    display: grid;
    gap: 0.375rem;
    margin: 0.5rem 0 0;
    padding-left: 1.25rem;
  }

  .points li::marker {
    color: var(--tan);
  }

  /* Columns: a photo on top, then a list. */
  .style-columns {
    gap: 2.5rem 1.5rem;
  }

  .style-columns .item {
    display: grid;
    gap: 1.125rem;
    align-content: start;
  }

  .style-columns :global(.item-photo) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-photo);
  }

  /* Pairs: title and text, separated by rules. */
  .style-pairs {
    border-top: 2px solid var(--oat);
  }

  .style-pairs .item {
    padding-block: 1.25rem;
    border-bottom: 2px solid var(--oat);
  }

  .style-pairs .item:has(:global(.item-photo)) {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .style-pairs :global(.item-photo) {
    width: 5.5rem;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius);
  }

  /* Steps: numbered, because the order matters. */
  .style-steps {
    counter-reset: step;
    gap: 1rem;
  }

  .style-steps .item {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .style-steps .item::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--sage);
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
  }

  .style-steps .item-body {
    padding-top: 0.5rem;
  }

  .foot {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    max-width: var(--measure);
    margin-top: 2rem;
  }

  @media (min-width: 40rem) {
    .style-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 56rem) {
    .style-columns.count-3,
    .style-columns.count-6 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .style-pairs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(2rem, 5vw, 4rem);
      border-top: 0;
    }

    .style-pairs .item:nth-child(-n + 2) {
      border-top: 2px solid var(--oat);
    }

    .style-steps {
      max-width: 48rem;
    }
  }
</style>
